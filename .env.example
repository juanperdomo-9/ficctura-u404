# Copiá este archivo como ".env" y completá los valores reales.
# El archivo ".env" NUNCA se sube a ningún repositorio (ver .gitignore).
#
# En LOCAL no hace falta tocar nada de lo de abajo (SECRET_KEY, DEBUG,
# etc.) — settings.py ya tiene defaults de desarrollo. Estas variables
# son para cuando se despliega en Render: se cargan ahí en el
# dashboard del servicio (o via render.yaml con "generateValue: true"
# para SECRET_KEY), nunca en este archivo.
#   SECRET_KEY      — clave larga y random, distinta a la de acá abajo
#   DEBUG           — "False" en producción
#   ALLOWED_HOSTS    — dominios propios separados por coma, ej:
#                       ficctura.com.ar,www.universo404.com.ar
#                       (el hostname *.onrender.com se agrega solo)
#   DATABASE_URL    — connection string de Neon (postgresql://...)
#   CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
#                   — del dashboard de cloudinary.com (cuenta gratis).
#                     Sin esto, las fotos de producto se guardan en el
#                     disco de Render, que es efímero y se borra en
#                     cada deploy.

# Payway (cobro con tarjeta) — Payway entrega estas claves recién
# cuando el cliente activa CUIT/facturación (soporte@payway.com.ar).
# Vacías = el checkout deshabilita "tarjeta" con una nota, en vez de
# fingir que cobra.
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
# "developer" (sandbox) o "production" — usar developer hasta probar
# con un pago de prueba real.
PAYWAY_ENV=developer

# WhatsApp de confirmación de compra (Twilio) — hace falta una cuenta
# de Twilio con WhatsApp habilitado (https://www.twilio.com/whatsapp)
# y, para producción real, un número de WhatsApp Business aprobado por
# Meta. Vacías = no se manda ningún WhatsApp, el checkout sigue
# funcionando igual (ver catalog/whatsapp.py).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
